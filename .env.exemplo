# Copie este arquivo para ".env" (na pasta onde você roda o sentinela) e preencha.
# O arquivo .env NUNCA deve ir para o GitHub (já está no .gitignore).

# --- Inteligência artificial (opcional) ---
# Crie uma chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Provedor: gemini | nenhuma
SENTINELA_IA=gemini
# Modelo do Gemini
SENTINELA_MODELO_IA=gemini-3.5-flash

# --- Credenciais usadas nos roteiros com {env.NOME} ---
# Os exemplos usam as senhas PÚBLICAS dos sites de demonstração como padrão.
# Em um sistema real, coloque as credenciais de teste aqui, nunca no roteiro.
SAUCE_SENHA=
INTERNET_SENHA=

# --- Banco de dados (Auditor e comandos verificar_banco) ---
# Padrão do XAMPP: root sem senha. Defina uma senha forte no MySQL e coloque aqui.
SENTINELA_DB_HOST=127.0.0.1
SENTINELA_DB_PORTA=3306
SENTINELA_DB_USUARIO=root
SENTINELA_DB_SENHA=
# Pasta do XAMPP (padrão C:\xampp)
SENTINELA_XAMPP=C:\xampp
